{
  "name": "anchor",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "build": "pnpm run build:server",
    "build:server": "tsc && pnpm run build:html",
    "build:html": "cp -r src/pages dist/ && cp -r src/emails dist/",
    "check": "tsc --noEmit && eslint src",
    "format": "prettier --write \"src/**/*.{ts,js,json,html}\"",
    "start": "node dist/index.js",
    "test": "pnpm run build:server && ANCHOR_LOG_FILE=/dev/null node --test test/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/express": "^5.0.3",
    "@types/express-ws": "^3.0.5",
    "@types/luxon": "^3.7.3",
    "@types/mjml": "^4.7.4",
    "@types/mustache": "^4.2.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@types/node": "^22.18.1",
    "@welshman/lib": "^0.6.3",
    "@welshman/signer": "^0.6.3",
    "@welshman/util": "^0.6.3",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-ws": "^5.0.2",
    "localstorage-polyfill": "^1.0.1",
    "luxon": "^3.7.2",
    "mjml": "^4.15.3",
    "mustache": "^4.2.0",
    "nostr-tools": "^2.16.2",
    "postmark": "^4.0.5",
    "sqlite3": "^5.1.7",
    "ws": "^8.18.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3"
    ]
  }
}
